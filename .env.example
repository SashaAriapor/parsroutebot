# =============================================================================
# Telegram Bot
# =============================================================================

# Get your bot token from @BotFather on Telegram (/newbot)
BOT_TOKEN=your_bot_token_here

# =============================================================================
# Database (PostgreSQL)
# =============================================================================

DATABASE_URL=postgresql://user:password@localhost:5432/parsroute_bot

# =============================================================================
# Redis (for BullMQ job queues)
# =============================================================================

REDIS_URL=redis://localhost:6379

# =============================================================================
# Admin Configuration
# =============================================================================

# Comma-separated list of Telegram user IDs who have admin access.
# To find your ID: message @userinfobot on Telegram — it will reply with your numeric ID.
# Example: ADMIN_IDS=123456789,987654321
ADMIN_IDS=your_telegram_user_id

# =============================================================================
# Log Channel
# =============================================================================

# Telegram channel ID where the bot will post logs and notifications.
# The ID is always a large negative number (e.g. -1001234567890).
# Steps to set up:
#   1. Create a Telegram channel (public or private)
#   2. Add your bot as an administrator with "Post Messages" permission
#   3. Forward any message from the channel to @userinfobot to retrieve the channel ID
#   4. Paste the negative ID here
LOG_CHANNEL_ID=-1001234567890

# =============================================================================
# 3X-UI Panel
# =============================================================================

# Full URL of your 3X-UI panel, INCLUDING the secret webBasePath (secret path).
# Format: http://<server-ip>:<port>/<webBasePath>
# Example: http://1.2.3.4:54321/abc123secretpath
#
# Where to find the webBasePath:
#   3X-UI → Settings → Panel Config → Web Path (the secret path you configured)
#
# Do NOT include a trailing slash. The config validator will warn and strip it.
XUI_PANEL_URL=http://your-server-ip:54321/your-secret-path

# 3X-UI panel admin credentials
XUI_USERNAME=admin
XUI_PASSWORD=your_xui_password

# The single inbound ID where all VPN clients are created.
# Find it in 3X-UI → Inbounds → the "ID" column (e.g. 1).
XUI_INBOUND_ID=1

# Subscription URL parts — the bot assembles them as:
#   {PROTOCOL}://{DOMAIN}:{PORT}{PATH}{subId}
# Example: http://p.swshao.ir:2095/sub/ZdyNgKq1Bc2X1abi
#
# XUI_SUB_DOMAIN: hostname only — no protocol, no port, no path.
#   If you accidentally paste a full URL (http://host:port/path), the config
#   validator will strip the extra parts automatically.
XUI_SUB_PROTOCOL=https
XUI_SUB_DOMAIN=sub.yourdomain.com
XUI_SUB_PORT=2096
XUI_SUB_PATH=/sub/

# =============================================================================
# TON Payment
# =============================================================================

# Your TON wallet address in NON-BOUNCEABLE format.
# Must start with "UQ" and be exactly 48 characters.
#
# WHY non-bounceable (UQ...) and not bounceable (EQ...)?
#   - Bounceable (EQ...): designed for smart contracts — if the destination
#     contract rejects a payment, the TON bounces back to the sender.
#   - Non-bounceable (UQ...): for regular user wallets — payments do not
#     bounce. Always use this format when receiving payments.
#
# How to get your non-bounceable address:
#   Tonkeeper:      Wallet → Receive → copy the address (should start with UQ)
#   MyTonWallet:   Menu → Receive → Copy address (select "Non-bounceable")
TON_WALLET_ADDRESS=UQyour_wallet_address_here

# Optional: TonAPI key for higher rate limits when polling transactions.
# Get one free at https://tonconsole.com
TONAPI_KEY=

# =============================================================================
# App Settings
# =============================================================================

NODE_ENV=development
LOG_LEVEL=info

# =============================================================================
# SOCKS5 Proxy (optional — needed if running on Iranian servers)
# =============================================================================

# Leave SOCKS5_HOST empty to disable proxy entirely.
# Example: SOCKS5_HOST=1.2.3.4
SOCKS5_HOST=
SOCKS5_PORT=1080
SOCKS5_USER=
SOCKS5_PASS=
