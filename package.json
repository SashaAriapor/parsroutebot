{
  "name": "parsroute-bot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/main.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test:xui": "tsx scripts/test-xui.ts",
    "test:ton": "tsx scripts/test-ton.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@grammyjs/conversations": "^1.2.0",
    "@prisma/client": "^5.7.0",
    "@ton/core": "^0.63.1",
    "@ton/ton": "^16.2.4",
    "axios": "^1.16.0",
    "axios-cookiejar-support": "^7.0.0",
    "bullmq": "^5.0.0",
    "dotenv": "^16.3.0",
    "grammy": "^1.21.0",
    "ioredis": "^5.10.1",
    "nanoid": "^3.3.7",
    "pino": "^8.17.0",
    "pino-pretty": "^10.3.0",
    "qrcode": "^1.5.4",
    "socks-proxy-agent": "^7.0.0",
    "tough-cookie": "^6.0.1",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/tough-cookie": "^4.0.5",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "prisma": "^5.7.0",
    "tsc-alias": "^1.8.0",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0"
  }
}
